<?xml version="1.0" encoding="utf-8"?>
<!--
  RansomShield.Driver.vcxproj  —  OPTIONAL certification / analysis project
  =========================================================================
  This is a SECOND project that compiles the very same kernel sources as
  RansomShield.vcxproj, but as a true WDK "Driver" project (ConfigurationType=Driver,
  Filesystem Mini-Filter template). The default build of the product uses the
  NuGet-only RansomShield.vcxproj (ConfigurationType=DynamicLibrary), which does
  NOT support the WDK build targets required by:

      * Static Driver Verifier (SDV)   ->  msbuild RansomShield.Driver.vcxproj /t:sdv
      * Driver Verification Log (DVL)   ->  dvl.exe / "Create Driver Verification Log"
      * Full driver Code Analysis       ->  the C28xxx driver rules in RansomShield.ruleset
      * Inf2Cat catalog generation      ->  EnableInf2cat

  REQUIREMENTS (build machine only — NOT needed by normal contributors):
      * The Windows Driver Kit (WDK) for 10.0.26100, installed as the VS
        "Windows Driver Kit" extension (not just the NuGet headers/libs).
      * Visual Studio 2025 with the v145 toolset and the Spectre-mitigated libs.

  This project is intentionally kept out of the default solution build flow so that
  contributors who only have the NuGet packages can keep building the product.
  See certification/scripts/Invoke-Sdv-Dvl.ps1 and the certification report for use.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <!-- Distinct GUID from RansomShield.vcxproj so both can coexist in a solution. -->
    <ProjectGuid>{C3D4E5F6-A7B8-9012-CDEF-234567890123}</ProjectGuid>
    <RootNamespace>RansomShieldDriver</RootNamespace>
    <ProjectName>RansomShield.Driver</ProjectName>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <TargetVersion>Windows10</TargetVersion>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <!-- Same output name as the product so SDV/DVL/HLK reference RansomShield.sys. -->
    <TargetName>RansomShield</TargetName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <PlatformToolset>v145</PlatformToolset>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!-- Build the catalog from the INF; required input for the attestation package. -->
    <EnableInf2cat>true</EnableInf2cat>
    <!-- Spectre-mitigated runtime is a Hardware Compatibility Program expectation. -->
    <SpectreMitigation>Spectre</SpectreMitigation>
  </PropertyGroup>

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)x64\$(Configuration)\Driver\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\DriverObj\</IntDir>
    <!-- Same certification ruleset the NuGet project uses; here the C28xxx
         driver rules actually load because the WDK analyzers are present. -->
    <CodeAnalysisRuleSet>$(SolutionDir)certification\rulesets\RansomShield.ruleset</CodeAnalysisRuleSet>
    <RunCodeAnalysis Condition="'$(RunCodeAnalysis)'==''">false</RunCodeAnalysis>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <!-- The driver sources share the product's include directories. -->
      <AdditionalIncludeDirectories>$(SolutionDir)kernel;$(SolutionDir)usermode\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NTDDI_VERSION=0x0A000009;_WIN32_WINNT=0x0A00;POOL_NX_OPTIN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- The Filter Manager import lib; fltMgr.lib comes from the installed WDK. -->
      <AdditionalDependencies>%(AdditionalDependencies);fltMgr.lib</AdditionalDependencies>
    </Link>
    <!-- Stamp DriverVer/version into the INF at build time (matches RansomShield.rc). -->
    <Inf>
      <SpecifyDriverVerDirective>true</SpecifyDriverVerDirective>
      <TimeStamp>1.0.0.0</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="kernel\RansomShield.c" />
    <ClCompile Include="kernel\RsContext.c" />
    <ClCompile Include="kernel\RsCommPort.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="kernel\RansomShield.h" />
    <ClInclude Include="usermode\common\SharedDefs.h" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="kernel\RansomShield.rc" />
  </ItemGroup>

  <ItemGroup>
    <!-- Including the INF in a Driver project enables Inf2Cat + catalog signing. -->
    <Inf Include="RansomShield.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

</Project>
